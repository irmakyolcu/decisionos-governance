# =====================================================================
# DecisionOS — On-premise (air-gapped) configuration
# Copy to `deploy/.env` and fill in. NEVER commit the filled file.
# Generate all keys/secrets with:  ./deploy/scripts/generate-keys.sh
# =====================================================================

# ---- Deployment identity -------------------------------------------
# Hostname the app is reached at inside the corporate network.
PUBLIC_HOSTNAME=decisionos.acme.local
# Full external base URL (http:// if TLS is terminated by a corporate LB)
SITE_URL=https://decisionos.acme.local
# API gateway URL the browser talks to (must be reachable from clients)
API_EXTERNAL_URL=https://decisionos.acme.local/api

# ---- Ports (host side) ----------------------------------------------
APP_HTTP_PORT=8080
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ---- Postgres --------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ---- JWT / API keys (generate-keys.sh) -------------------------------
# Min 32 chars. All Supabase services sign/verify with this.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRY=3600
ANON_KEY=CHANGE_ME_ANON_JWT
SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_JWT

# ---- Auth (GoTrue) ---------------------------------------------------
DISABLE_SIGNUP=true
MAILER_AUTOCONFIRM=true
JWT_AUD=authenticated
# Comma separated additional redirect targets
ADDITIONAL_REDIRECT_URLS=https://decisionos.acme.local

# Internal SMTP relay (leave blank to disable all outbound email)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=decisionos@acme.local
SMTP_SENDER_NAME=DecisionOS

# ---- Storage ---------------------------------------------------------
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

# ---- Local AI (Ollama / vLLM) ---------------------------------------
# OpenAI-compatible endpoint. Ollama: http://ollama:11434/v1
# vLLM:  http://vllm:8000/v1
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=not-needed-for-local
AI_CHAT_MODEL=qwen2.5:14b-instruct
AI_EMBEDDING_MODEL=nomic-embed-text
# Master switch: set to false to disable every AI feature in the product
AI_ENABLED=true
# Hard guarantee for air-gapped installs: block any non-local AI host
AI_ALLOW_EXTERNAL=false

# Speech features require a local Whisper/Piper service; blank = disabled
STT_BASE_URL=
TTS_BASE_URL=

# ---- Outbound network policy ----------------------------------------
# Air-gapped installs must keep this false. Disables Gmail/Slack/Teams
# connectors, external data sources and any egress from edge functions.
ALLOW_OUTBOUND_INTERNET=false

# ---- Offline licensing ----------------------------------------------
# Deployment ID is generated by scripts/generate-keys.sh; send it to the
# vendor, receive a license key back, then run:
#   ./scripts/license-activate.sh <license-key>
DEPLOYMENT_ID=
DECISIONOS_LICENSE=
# Vendor's Ed25519 public key (base64url). Same for every customer.
DECISIONOS_LICENSE_PUBLIC_KEY=
DECISIONOS_VERSION=1.0.0
